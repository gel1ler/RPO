// libnfc и OpenSSL через Homebrew (Apple Silicon: /opt/homebrew).
// brew install libnfc openssl@3
// Intel Homebrew: добавьте строки с /usr/local/opt/libnfc и /usr/local/opt/openssl@3
//    (см. terminal/README.md).

HEADER_SEARCH_PATHS = $(inherited) /opt/homebrew/opt/libnfc/include /opt/homebrew/opt/openssl@3/include
LIBRARY_SEARCH_PATHS = $(inherited) /opt/homebrew/opt/libnfc/lib /opt/homebrew/opt/openssl@3/lib
OTHER_LDFLAGS = $(inherited) -lnfc -lssl -lcrypto
